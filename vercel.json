{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/amazingcthomes.dc.html" },
    { "source": "/contact", "destination": "/Kavitha Sathya.dc.html" }
  ],
  "headers": [
    {
      "source": "/houseimages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_ds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
